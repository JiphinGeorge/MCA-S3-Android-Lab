<?xml version="1.0" encoding="utf-8"?>

<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#114C75"
    android:columnCount="4"
    android:padding="20dp"
    android:rowCount="7"
    android:useDefaultMargins="true">

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_columnSpan="4"
        android:background="#C9E0D7D7"
        android:gravity="right|bottom"
        android:padding="15dp"
        android:text="0"
        android:textColorLink="#BD7A7A"
        android:textSize="56dp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/clear"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="C"
        android:textSize="20sp" />

    <Button
        android:id="@+id/percent"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="%"
        android:textSize="20sp" />

    <Button
        android:id="@+id/backspace"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="⌫"
        android:textSize="20sp" />

    <Button
        android:id="@+id/divide"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="÷"
        android:textSize="20sp" />

    <Button
        android:id="@+id/seven"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="7"
        android:textSize="20sp" />

    <Button
        android:id="@+id/eight"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="8"
        android:textSize="20sp" />

    <Button
        android:id="@+id/nine"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="9"
        android:textSize="20sp" />

    <Button
        android:id="@+id/multiply"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="×"
        android:textSize="20sp" />

    <Button
        android:id="@+id/four"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="4"
        android:textSize="20sp" />

    <Button
        android:id="@+id/five"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="5"
        android:textSize="20sp" />

    <Button
        android:id="@+id/six"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="6"
        android:textSize="20sp" />

    <Button
        android:id="@+id/subtract"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="−"
        android:textSize="20sp" />

    <Button
        android:id="@+id/one"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="1"
        android:textSize="20sp" />

    <Button
        android:id="@+id/two"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="2"
        android:textSize="20sp" />

    <Button
        android:id="@+id/three"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="3"
        android:textSize="20sp" />

    <Button
        android:id="@+id/add"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="+"
        android:textSize="20sp" />

    <Button
        android:id="@+id/zero"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="0"
        android:textSize="20sp" />

    <Button
        android:id="@+id/dot"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnWeight="1"
        android:text="."
        android:textSize="20sp" />

    <Button
        android:id="@+id/equal"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_columnSpan="2"
        android:layout_columnWeight="2"
        android:text="="
        android:textSize="20sp"
        android:textStyle="bold" />

</GridLayout>