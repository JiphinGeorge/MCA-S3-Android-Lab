<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#37A672"
    android:backgroundTintMode="add"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Simple Calculator"
        android:textColor="#000000"
        android:textSize="24sp" />


    <EditText
        android:id="@+id/editTextText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ADAD52"
        android:backgroundTint="#C72D2D"
        android:hint="Enter 1st number"
        android:inputType="number"
        android:padding="10dp"
        android:textColor="#FDFDFD"
        android:textColorHighlight="#AF7777"
        android:textColorHint="#FFFFFF" />

    <EditText
        android:id="@+id/editTextText2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F5DC"
        android:hint="Enter 2nd number"
        android:inputType="number"
        android:padding="10dp"
        android:textColorHint="#490909" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#499A13"
            android:text="Sum"
            android:textColor="#FBEFEF" />

        <Button
            android:id="@+id/button2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#499A13"
            android:text="Mul"
            android:textColor="#FBEFEF" />

        <Button
            android:id="@+id/button3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#499A13"
            android:text="Div"
            android:textColor="#FBEFEF" />

        <Button
            android:id="@+id/button4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#499A13"
            android:text="Sub"
            android:textColor="#FBEFEF" />

    </LinearLayout>

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="#FFBF00"
        android:gravity="center"
        android:hint="Output"
        android:padding="10dp"
        android:textSize="20sp" />

</LinearLayout>