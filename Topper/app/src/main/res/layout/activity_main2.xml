<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity2">

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="33dp"
        android:text="Student Details"
        android:textSize="200sp" />

    <TextView
        android:id="@+id/std1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="40sp"
        android:text="Student 1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_weight="1"
        android:text="TextView" />

    <EditText
        android:id="@+id/name1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_weight="1"
        android:text="TextView" />

    <EditText
        android:id="@+id/rollno1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_weight="1"
        android:text="TextView" />

    <EditText
        android:id="@+id/mark1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name" />

    <TextView
        android:id="@+id/std2"
        android:layout_width="match_parent"
        android:layout_height="33dp"
        android:text="Student 1"
        tools:layout_editor_absoluteX="51dp"
        tools:layout_editor_absoluteY="49dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_weight="1"
        android:text="TextView" />

    <EditText
        android:id="@+id/name2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_weight="1"
        android:text="TextView" />

    <EditText
        android:id="@+id/rollno2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_weight="1"
        android:text="TextView" />

    <EditText
        android:id="@+id/mark2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name" />

    <TextView
        android:id="@+id/std3"
        android:layout_width="match_parent"
        android:layout_height="33dp"
        android:text="Student 1"
        tools:layout_editor_absoluteX="51dp"
        tools:layout_editor_absoluteY="49dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_weight="1"
        android:text="TextView" />

    <EditText
        android:id="@+id/name3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_weight="1"
        android:text="TextView" />

    <EditText
        android:id="@+id/rollno3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_weight="1"
        android:text="TextView" />

    <EditText
        android:id="@+id/mark3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name" />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Topper"
        android:id="@+id/top"/>


</LinearLayout>